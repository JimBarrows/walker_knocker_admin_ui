{
  "name": "walker_knocker_admin_ui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "android:bundle": "react-native bundle --dev false --entry-file index.android.js --platform android --bundle-output android/app/src/main/assets/index.android.bundle",
    "android:bundle:dev": "react-native bundle --entry-file index.android.js --platform android --bundle-output android/app/src/main/assets/index.android.bundle",
    "build": "npm run build:bundle;npm run build:web",
    "build:web": "docker build --tag thejimbarrows/walker_knocker_admin_ui --rm .",
    "build:bundle": "webpack --config web/webpack/web.prod.config.js --progress --colors",
    "clear:cache": "gulp clear-cache",
    "dev:web": "webpack --progress --colors --watch -d --config web/webpack/web.dev.config.js",
    "ios:bundle": "react-native bundle --dev false --entry-file index.ios.js --platform ios --bundle-output ios/main.jsbundle",
    "ios:bundle:dev": "react-native bundle --entry-file index.ios.js --platform ios --bundle-output ios/main.jsbundle",
    "push": "docker push thejimbarrows/walker_knocker_admin_ui:latest",
    "start": "npm run start:web; npm  run start:native",
    "start:native": "react-native start",
    "start:web": "docker-compose up",
    "test": "npm run test:cucubmer; npm run test:native",
    "test:native": "jest",
    "test:cucumber": "cucumber-js --compiler es6:babel-core/register "
  },
  "dependencies": {
    "apollo-client": "^1.5.0",
    "bootstrap-react-components": "^0.17.2",
    "graphql-tag": "^2.4.2",
    "jsonwebtoken": "^7.4.1",
    "jwt-decode": "^2.2.0",
    "react": "15.3.2",
    "react-apollo": "^1.0.0-rc.2",
    "react-dom": "15.3.2",
    "react-native": "0.37.0",
    "react-redux": "^4.4.6",
    "react-router": "^2.5.2",
    "react-router-redux": "^4.0.8",
    "react-templates-and-utils": "^0.4.1",
    "redux": "^3.6.0",
    "redux-auth-wrapper": "^1.0.0",
    "redux-devtools": "^3.3.2",
    "redux-logger": "^2.8.2",
    "redux-thunk": "^2.2.0",
    "webpack": "^3.0.0"
  },
  "devDependencies": {
    "babel-cli": "^6.26.0",
    "babel-core": "^6.25.0",
    "babel-jest": "^20.0.3",
    "babel-loader": "^7.1.0",
    "babel-plugin-add-module-exports": "^0.2.1",
    "babel-plugin-react-html-attrs": "^2.0.0",
    "babel-plugin-transform-class-properties": "^6.24.1",
    "babel-plugin-transform-decorators-legacy": "^1.3.4",
    "babel-polyfill": "^6.23.0",
    "babel-preset-es2015": "^6.24.1",
    "babel-preset-react": "^6.24.1",
    "babel-preset-react-native": "^2.0.0",
    "babel-preset-stage-2": "^6.24.1",
    "babel-register": "^6.24.1",
    "jest": "20.0.4",
    "react-test-renderer": "15.3.2"
  },
  "jest": {
    "preset": "react-native"
  }
}
